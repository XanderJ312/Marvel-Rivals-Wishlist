# Your contact (e-mail or Telegram handle). It goes into the User-Agent header
# so the wiki admins can reach you if something goes wrong (MediaWiki API etiquette).
WIKI_CONTACT=you@example.com

# Delay between wiki API requests, in seconds (do not lower it)
REQUEST_DELAY=1.0

# Day of the month (1–28) when the hero list is refreshed
HEROES_DAY_OF_MONTH=15

# --- Telegram (optional) ---
# Bot token from @BotFather. Without it the app works in a regular browser only.
TELEGRAM_BOT_TOKEN=
# Label of the bot's menu button
MENU_BUTTON_TEXT=Skins
# Permanent HTTPS address (your own domain). Empty = free Cloudflare quick tunnel from docker-compose.
PUBLIC_URL=
